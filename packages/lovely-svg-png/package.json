{
	"name": "lovely-svg-png",
	"version": "0.1.0",
	"description": "Rasterize SVG strings to PNG in the browser, with webfonts embedded as data: URIs (@import chains included)",
	"license": "MIT",
	"author": "Alexey Zaytsev <alexey.zaytsev@gmail.com>",
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test:unit": "vitest",
		"test": "vitest --run",
		"prepack": "bun run build && cp ../../LICENSE LICENSE && publint",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"devDependencies": {
		"@vitest/browser-playwright": "^4.1.10",
		"playwright": "^1.62.1",
		"publint": "^0.3.23",
		"typescript": "^5.9",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"svg",
		"png",
		"rasterize",
		"svg-to-png",
		"font-face",
		"webfont"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xl0/svelte-asciiart.git",
		"directory": "packages/lovely-svg-png"
	},
	"bugs": {
		"url": "https://github.com/xl0/svelte-asciiart/issues"
	},
	"homepage": "https://github.com/xl0/svelte-asciiart#readme"
}
