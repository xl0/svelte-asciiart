{
	"name": "svelte-asciiart-monorepo",
	"private": true,
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"packages/*",
		"demo"
	],
	"scripts": {
		"dev": "bun --cwd=demo run dev",
		"build": "bun --cwd=demo run build",
		"build:demo": "bun --cwd=demo run build:demo",
		"preview": "bun --cwd=demo run preview",
		"check": "bun --cwd=packages/svelte-asciiart run check && bun --cwd=demo run check",
		"test": "bun --cwd=packages/svelte-asciiart run test",
		"release": "bun scripts/release.ts",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2"
	}
}
