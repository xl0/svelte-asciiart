{
	"name": "svelte-asciiart-demo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"dependencies": {
		"svelte-asciiart": "workspace:*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "bun --cwd=../packages/svelte-asciiart run prepack && vite build",
		"build:demo": "bun --cwd=../packages/svelte-asciiart run prepack && BASE_PATH=/svelte-asciiart vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.31.0",
		"@shikijs/rehype": "^4.4.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.2.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-html": "^16.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.4.3",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9",
		"unified": "^11.0.5",
		"vite": "^8.2.1",
		"vite-plugin-devtools-json": "^1.1.0"
	}
}
